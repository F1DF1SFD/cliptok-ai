# Backend
CLIPTOK_DATA_DIR=./backend/data
CLIPTOK_WHISPER_MODEL=base
CLIPTOK_WHISPER_DEVICE=auto
CLIPTOK_WHISPER_COMPUTE=int8
CLIPTOK_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CLIPTOK_MAX_CLIP_SECONDS=600
CLIPTOK_MAX_UPLOAD_MB=512

# Optional binary overrides
# CLIPTOK_FFMPEG=/opt/homebrew/bin/ffmpeg
# CLIPTOK_FFPROBE=/opt/homebrew/bin/ffprobe
# CLIPTOK_YTDLP=/opt/homebrew/bin/yt-dlp

# Frontend (place in frontend/.env.local)
# Leave empty to call the same origin and let Next proxy /api to the backend
# (needed for share links and tunnels). Set it for two-port development.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Where Next proxies /api. Read at build time, so rebuild after changing it.
CLIPTOK_API_ORIGIN=http://127.0.0.1:8000

# scripts/share.sh: auto | on | off (public tunnel via cloudflared)
CLIPTOK_TUNNEL=auto
